# ---- core ----
PORT=4000
NODE_ENV=production
# Comma separated list of origins allowed to call the API. Use * only for testing.
CORS_ORIGIN=http://localhost:5173

# ---- database ----
DATABASE_URL=postgres://tat:tat_password@localhost:5432/tat
# Set to "require" if your managed Postgres enforces TLS (AWS RDS, Azure, Neon...)
PGSSLMODE=disable

# ---- auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# First admin created by `npm run seed`
BOOTSTRAP_ADMIN_NAME=Brand Manager
BOOTSTRAP_ADMIN_EMPLOYEE_ID=MGR2001
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.in
BOOTSTRAP_ADMIN_PASSWORD=change_this_on_first_login

# ---- photo storage ----
# local  = write to a disk volume on your server
# s3     = any S3 compatible bucket (AWS S3, MinIO, DigitalOcean Spaces, Wasabi)
STORAGE_DRIVER=local
UPLOAD_DIR=/var/lib/tat/uploads
MAX_UPLOAD_MB=6

S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
